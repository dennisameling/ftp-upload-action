{
	"name": "ftp-upload-action",
	"version": "0.0.0",
	"private": true,
	"description": "FTP upload action",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"format": "prettier --write '**/*.ts'",
		"format-check": "prettier --check '**/*.ts'",
		"lint": "eslint .",
		"package": "rm -rf ./dist && bun build ./src/main.ts --outdir=./dist --entry-naming='[dir]/index.[ext]' --target=node --format=esm --sourcemap=linked",
		"test": "bun test",
		"all": "bun run build && bun run format && bun run lint && bun run package && bun test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dennisameling/ftp-upload-action.git"
	},
	"keywords": [
		"actions",
		"node",
		"setup"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"basic-ftp": "^6.0.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.5",
		"globals": "^17.6.0",
		"js-yaml": "^4.1.1",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
