{
	"name": "ftp-upload-action",
	"version": "0.0.0",
	"private": true,
	"description": "FTP upload action",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"check": "biome check --write",
		"check-ci": "biome check",
		"package": "rm -rf ./dist && bun build ./src/main.ts --outdir=./dist --entry-naming='[dir]/index.[ext]' --target=node --format=esm --sourcemap=linked",
		"test": "bun test",
		"all": "bun run build && bun run check && bun run package && bun test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dennisameling/ftp-upload-action.git"
	},
	"keywords": [
		"actions",
		"node",
		"setup"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"basic-ftp": "^6.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24.19.0"
	}
}
